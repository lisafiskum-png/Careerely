# Copy to .env.local for local development. Set the same variables in Vercel
# (Project → Settings → Environment Variables) for Preview and Production.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, used for Stripe redirects and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Careerely profiles shown in the landing and authenticated footers.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring prices: $29 / $49 / $79.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# ── Transactional email ──────────────────────────────────────────────────────
# Sends the account + subscription confirmation after successful payment.
RESEND_API_KEY=

# ── Claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
CLAUDE_MODEL=

# ── Opportunity Engine ───────────────────────────────────────────────────────
# Supabase Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/engine/tick
# every minute. The engine creates idempotent five-minute market cycles 24/7.
CRON_SECRET=

# Optional global Google Jobs discovery. Keep disabled until SerpApi usage and
# spend are intentionally approved. Direct Greenhouse/Lever/Ashby ingestion and
# Careerely's continuous scans work independently of this switch.
SERPAPI_KEY=
GLOBAL_JOB_DISCOVERY_ENABLED=false
# Optional when enabled. Default 30, minimum 10 minutes.
GLOBAL_DISCOVERY_INTERVAL_MINUTES=30

# ── Local end-to-end tests only ─────────────────────────────────────────────
# Never set these in Vercel. playwright.config.ts sets them for the test run.
# STRIPE_API_BASE=http://localhost:12111   (stripe-mock)
# ANTHROPIC_BASE_URL=http://localhost:4010 (e2e/mock-anthropic.mjs)
